{
  "name": "harvest-outlook",
  "private": true,
  "version": "0.1.0",
  "description": "Harvest Outlook: crop comparison, visual season planning and journal PWA for Indian farmers.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "dev": "pnpm --parallel --filter @harvest/api --filter @harvest/web run dev",
    "db:migrate": "pnpm --filter @harvest/api run db:migrate",
    "db:seed": "pnpm --filter @harvest/api exec tsx ../../scripts/seed/seed.ts",
    "test:e2e": "pnpm --filter @harvest/web exec playwright test",
    "smoke:openmeteo": "pnpm --filter @harvest/api run smoke:openmeteo",
    "smoke:meta": "pnpm --filter @harvest/api exec tsx ../../scripts/smoke/meta-smoke.ts",
    "smoke:live": "sh -c 'pnpm run smoke:openmeteo; pnpm run smoke:meta; pnpm run smoke:elevenlabs; true'",
    "smoke:elevenlabs": "pnpm --filter @harvest/api exec tsx ../../scripts/smoke/elevenlabs-smoke.ts",
    "audit:data": "pnpm --filter @harvest/scripts exec tsx catalogue/validate.ts && echo \"See docs/DATA_AUDIT.md and docs/CROP_CATALOGUE.md\"",
    "analytics:test": "analytics/.venv/bin/python -m pytest analytics/tests -q",
    "catalogue:validate": "pnpm --filter @harvest/scripts exec tsx catalogue/validate.ts",
    "catalogue:build": "pnpm --filter @harvest/scripts exec tsx catalogue/build.ts",
    "catalogue:derive-rules": "pnpm --filter @harvest/scripts exec tsx catalogue/derive-rules.ts",
    "catalogue:districts": "pnpm --filter @harvest/scripts exec tsx catalogue/build-districts.ts",
    "catalogue:load": "pnpm --filter @harvest/scripts exec tsx catalogue/load-db.ts",
    "ingest:ginger-ka": "pnpm --filter @harvest/api exec tsx ../../scripts/seed/ingest-ginger-karnataka.ts",
    "audit:ginger-prices": "pnpm --filter @harvest/api exec tsx ../../scripts/seed/audit-ginger-prices.ts"
  }
}
