{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "jobId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "budgetGate": {
      "type": "string",
      "enum": [
        "reserved",
        "checked",
        "denied"
      ]
    },
    "manualFallbackAvailable": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "jobId",
    "budgetGate",
    "manualFallbackAvailable"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/tool.request_segmentation.output.json",
  "x-schemaVersion": "1.0"
}
