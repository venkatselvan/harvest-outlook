{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "passages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidenceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
          },
          "excerpt": {
            "type": "string"
          },
          "effectiveAvailableAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "scope": {
            "type": "object",
            "properties": {
              "level": {
                "type": "string",
                "enum": [
                  "farm",
                  "district",
                  "state",
                  "market",
                  "region",
                  "national"
                ]
              },
              "ids": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
                }
              },
              "boundaryVersion": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "level",
              "ids"
            ],
            "additionalProperties": false
          },
          "cropIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
            }
          }
        },
        "required": [
          "evidenceId",
          "excerpt",
          "effectiveAvailableAt",
          "scope",
          "cropIds"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "passages"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/tool.retrieve_evidence.output.json",
  "x-schemaVersion": "1.0"
}
