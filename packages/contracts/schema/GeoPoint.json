{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "Point"
    },
    "coordinates": {
      "type": "array",
      "items": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "additionalItems": false,
      "minItems": 2,
      "maxItems": 2
    },
    "accuracyM": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "basis": {
      "type": "string",
      "enum": [
        "gps",
        "geocoded",
        "centroid_proxy",
        "manual_pin",
        "source_reported"
      ]
    }
  },
  "required": [
    "type",
    "coordinates",
    "accuracyM",
    "basis"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/GeoPoint.json",
  "x-schemaVersion": "1.0"
}
