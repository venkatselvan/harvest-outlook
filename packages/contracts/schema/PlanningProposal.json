{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "cropId": {
      "type": "string"
    },
    "productId": {
      "type": "string"
    },
    "cropName": {
      "type": "string"
    },
    "productName": {
      "type": "string"
    },
    "season": {
      "type": "string"
    },
    "plannedSowingDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "plannedHarvestDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "harvestWindow": {
      "type": "object",
      "properties": {
        "earliest": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "latest": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        }
      },
      "required": [
        "earliest",
        "latest"
      ],
      "additionalProperties": false
    },
    "scope": {
      "type": "string",
      "enum": [
        "district",
        "state",
        "region",
        "national"
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 1000
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "conditional": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "cropId",
    "productId",
    "cropName",
    "productName",
    "season",
    "plannedSowingDate",
    "plannedHarvestDate",
    "harvestWindow",
    "scope",
    "reason",
    "evidenceRefs",
    "uncertainties",
    "conditional"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/PlanningProposal.json",
  "x-schemaVersion": "1.0"
}
