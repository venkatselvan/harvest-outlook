{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "effectiveFrom": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "currency": {
      "type": "string",
      "const": "USD"
    },
    "source": {
      "type": "object",
      "properties": {
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "retrievedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "verified": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "retrievedAt",
        "verified"
      ],
      "additionalProperties": false
    },
    "entries": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "meta",
              "elevenlabs"
            ]
          },
          "modelId": {
            "type": "string",
            "minLength": 1
          },
          "meter": {
            "type": "string",
            "enum": [
              "input_token",
              "output_token",
              "image",
              "audio_second",
              "character",
              "request"
            ]
          },
          "usdPerBlock": {
            "type": "string",
            "pattern": "^-?(0|[1-9]\\d*)(\\.\\d{1,6})?$"
          },
          "blockSize": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "provider",
          "modelId",
          "meter",
          "usdPerBlock",
          "blockSize"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "version",
    "effectiveFrom",
    "currency",
    "source",
    "entries"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/PriceTable.json",
  "x-schemaVersion": "1.0"
}
