{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "level": {
      "type": "string",
      "enum": [
        "farm",
        "district",
        "state",
        "market",
        "region",
        "national"
      ]
    },
    "ids": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
      }
    },
    "boundaryVersion": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "level",
    "ids"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/SpatialScope.json",
  "x-schemaVersion": "1.0"
}
