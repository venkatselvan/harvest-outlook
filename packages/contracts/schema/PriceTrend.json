{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "productId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "insufficient"
      ]
    },
    "missingReason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "price_history_not_ingested",
            "price_history_insufficient",
            "market_not_in_history",
            "price_residuals_insufficient",
            "price_interval_crossing"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "market",
            "district",
            "state",
            "national"
          ]
        },
        "requestedLevel": {
          "type": "string",
          "enum": [
            "market",
            "district",
            "state",
            "national"
          ]
        },
        "stateName": {
          "type": [
            "string",
            "null"
          ]
        },
        "districtName": {
          "type": [
            "string",
            "null"
          ]
        },
        "marketCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "marketIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fallbackNote": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "level",
        "requestedLevel",
        "stateName",
        "districtName",
        "marketCount",
        "marketIds",
        "fallbackNote"
      ],
      "additionalProperties": false
    },
    "unit": {
      "type": "string",
      "const": "INR/kg"
    },
    "priceBasis": {
      "type": "string",
      "const": "wholesale_mandi_modal"
    },
    "basisLabel": {
      "type": "string",
      "maxLength": 1000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "months": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "asOf": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "from": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "to": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}$"
          },
          "p50": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "n": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "markets": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "month",
          "p50",
          "n",
          "markets"
        ],
        "additionalProperties": false
      }
    },
    "yoy": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "lastMonthsWithData": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "priorMonthsWithData": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "pairedMonths": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "lastMean": {
              "type": "number",
              "minimum": 0
            },
            "priorMean": {
              "type": "number",
              "minimum": 0
            },
            "changePct": {
              "type": "number"
            }
          },
          "required": [
            "lastMonthsWithData",
            "priorMonthsWithData",
            "pairedMonths",
            "lastMean",
            "priorMean",
            "changePct"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "yoyMissingReason": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage": {
      "type": "object",
      "properties": {
        "observations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "markets": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "firstDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "validDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "excludedRows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "observations",
        "markets",
        "firstDate",
        "lastDate",
        "validDays",
        "excludedRows"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "productId",
    "status",
    "missingReason",
    "scope",
    "unit",
    "priceBasis",
    "basisLabel",
    "limitations",
    "months",
    "asOf",
    "from",
    "to",
    "series",
    "yoy",
    "yoyMissingReason",
    "coverage"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/PriceTrend.json",
  "x-schemaVersion": "1.0"
}
