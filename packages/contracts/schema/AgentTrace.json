{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
    },
    "ownerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "live",
        "replay",
        "synthetic"
      ]
    },
    "redactedInputs": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "modelId": {
      "type": "string",
      "minLength": 1
    },
    "prompts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "templateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "templateId",
          "version",
          "hash"
        ],
        "additionalProperties": false
      }
    },
    "toolCalls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "callId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
          },
          "tool": {
            "type": "string",
            "enum": [
              "resolve_crop_identity",
              "get_farm_context",
              "retrieve_evidence",
              "screen_crops",
              "get_market_outlook",
              "calculate_scenarios",
              "calculate_water_balance",
              "interpret_observation",
              "propose_plan_revision",
              "request_segmentation",
              "request_visual_keyframes",
              "get_job_status",
              "get_farm_briefing"
            ]
          },
          "inputHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "resultId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "rejected",
              "error",
              "timeout"
            ]
          },
          "latencyMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "errorCode": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "callId",
          "tool",
          "inputHash",
          "resultId",
          "status",
          "latencyMs",
          "errorCode"
        ],
        "additionalProperties": false
      }
    },
    "resultIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "enum": [
              "schema",
              "ownership_mode",
              "numeric_refs",
              "claim_evidence",
              "high_risk",
              "decision"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "step",
          "passed",
          "code"
        ],
        "additionalProperties": false
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "rounds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "repairAttempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "latencyMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tokens": {
      "type": "object",
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "output": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "input",
        "output"
      ],
      "additionalProperties": false
    },
    "cost": {
      "type": "object",
      "properties": {
        "estimatedUsd": {
          "type": "string",
          "pattern": "^-?(0|[1-9]\\d*)(\\.\\d{1,6})?$"
        },
        "settledUsd": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9]\\d*)(\\.\\d{1,6})?$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "estimatedUsd",
        "settledUsd"
      ],
      "additionalProperties": false
    },
    "startedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "evidenceStatesShown": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "observed",
          "farmer_reported",
          "derived",
          "forecast",
          "scenario",
          "illustrative",
          "unavailable"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "requestId",
    "ownerId",
    "mode",
    "redactedInputs",
    "modelId",
    "prompts",
    "toolCalls",
    "resultIds",
    "validations",
    "errors",
    "rounds",
    "repairAttempts",
    "latencyMs",
    "tokens",
    "cost",
    "startedAt",
    "evidenceStatesShown"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/AgentTrace.json",
  "x-schemaVersion": "1.0"
}
