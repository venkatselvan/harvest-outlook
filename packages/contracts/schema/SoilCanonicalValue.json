{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "value": {
      "type": [
        "number",
        "null"
      ]
    },
    "unit": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "conversion": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "formula": {
              "type": "string"
            },
            "version": {
