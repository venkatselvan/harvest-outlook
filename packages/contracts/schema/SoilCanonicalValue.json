          },
          "required": [
            "formula",
            "version"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "missingReason": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "value",
    "unit",
    "conversion",
    "missingReason"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/SoilCanonicalValue.json",
  "x-schemaVersion": "1.0"
