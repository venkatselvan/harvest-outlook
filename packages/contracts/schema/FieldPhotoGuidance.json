{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "sourceStage": {
      "type": "string"
    },
    "targetStage": {
      "type": "string"
    },
    "elapsedDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "targetAgeDays": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "growth": {
      "type": "string"
    },
    "weather": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "observed",
            "forecast",
            "typical",
            "unavailable"
          ]
        },
        "summary": {
          "type": "string"
        },
        "rainMm": {
          "type": [
            "number",
            "null"
          ]
        },
        "tMinC": {
          "type": [
            "number",
            "null"
          ]
        },
        "tMaxC": {
          "type": [
            "number",
            "null"
          ]
        },
        "sunshineHours": {
          "type": [
            "number",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        },
        "issuedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "summary",
        "rainMm",
        "tMinC",
        "tMaxC",
        "sunshineHours",
        "source",
        "issuedAt"
      ]
    },
    "interval": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "to": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "observedDays": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "forecastDays": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "typicalDays": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "missingDays": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "rainMm": {
          "type": [
            "number",
            "null"
          ]
        },
        "meanTempC": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "from",
        "to",
        "observedDays",
        "forecastDays",
        "typicalDays",
        "missingDays",
        "rainMm",
        "meanTempC"
      ]
    },
    "change": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "sourceStage",
    "targetStage",
    "elapsedDays",
    "targetAgeDays",
    "growth",
    "weather",
    "interval",
    "change",
    "limitations",
    "sources"
  ],
  "$id": "https://harvest-outlook.local/schema/1.0/FieldPhotoGuidance.json",
  "x-schemaVersion": "1.0"
}
