{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "contextId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
    },
    "preferencePolicyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
    },
    "cropIds": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
      }
    }
  },
  "required": [
    "contextId"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/tool.screen_crops.input.json",
  "x-schemaVersion": "1.0"
}
