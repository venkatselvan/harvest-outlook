{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
    },
    "nativeName": {
      "type": "string",
      "minLength": 1
    },
    "stateId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
    },
    "stateName": {
      "type": "string",
      "minLength": 1
    },
    "boundaryVersion": {
      "type": "string",
      "minLength": 1
    },
    "sourceCodes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "centroid": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Point"
            },
            "coordinates": {
              "type": "array",
              "items": [
                {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                }
              ],
              "additionalItems": false,
              "minItems": 2,
              "maxItems": 2
            },
            "accuracyM": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "basis": {
              "type": "string",
              "enum": [
                "gps",
                "geocoded",
                "centroid_proxy",
                "manual_pin",
                "source_reported"
              ]
            }
          },
          "required": [
            "type",
            "coordinates",
            "accuracyM",
            "basis"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "timeZone": {
      "default": "Asia/Kolkata",
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "live",
        "replay",
        "synthetic"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "nativeName",
    "stateId",
    "stateName",
    "boundaryVersion",
    "sourceCodes",
    "centroid",
    "mode"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/DistrictRef.json",
  "x-schemaVersion": "1.0"
}
