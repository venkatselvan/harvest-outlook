{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "live",
        "replay",
        "synthetic"
      ]
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri"
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "documentTitle": {
      "type": "string",
      "minLength": 1
    },
    "documentVersion": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "locator": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "row": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "content": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "excerpt"
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "language": {
              "type": "string",
              "minLength": 2
            }
          },
          "required": [
            "kind",
            "text",
            "language"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "structured_row"
            },
            "row": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            }
          },
          "required": [
            "kind",
            "row"
          ],
          "additionalProperties": false
        }
      ]
    },
    "publishedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "availability": {
      "type": "object",
      "properties": {
        "effectiveAvailableAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "type": "string",
          "enum": [
            "verified_publication",
            "first_observed",
            "conservative_upper_bound",
            "unverified"
          ]
        }
      },
      "required": [
        "effectiveAvailableAt",
        "basis"
      ],
      "additionalProperties": false
    },
    "ingestedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "revisedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "geography": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "farm",
            "district",
            "state",
            "market",
            "region",
            "national"
          ]
        },
        "ids": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
          }
        },
        "boundaryVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "level",
        "ids"
      ],
      "additionalProperties": false
    },
    "cropIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
      }
    },
    "productIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ha",
          "acre",
          "kg",
          "quintal",
          "t",
          "INR",
          "INR/kg",
          "INR/quintal",
          "INR/ha",
          "mm",
          "L",
          "m3",
          "kg/ha",
          "kg/acre",
          "days",
          "celsius",
          "percent",
          "m",
          "cm",
          "g",
          "months"
        ]
      }
    },
    "sourceUnits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "licence": {
      "type": "object",
      "properties": {
        "licence": {
          "type": "string",
          "minLength": 1
        },
        "accessStatus": {
          "type": "string",
          "enum": [
            "open",
            "registration_required",
            "permission_required",
            "restricted",
            "unknown"
          ]
        },
        "redistributable": {
          "type": "boolean"
        },
        "attribution": {
          "type": "string"
        }
      },
      "required": [
        "licence",
        "accessStatus",
        "redistributable"
      ],
      "additionalProperties": false
    },
    "extraction": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "structured_api",
            "native_text",
            "native_table",
            "ocr",
            "model_assisted",
            "manual"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "reviewedBy": {
          "default": "none",
          "type": "string",
          "enum": [
            "none",
            "human",
            "rule_check"
          ]
        }
      },
      "required": [
        "method",
        "version"
      ],
      "additionalProperties": false
    },
    "validationStatus": {
      "type": "string",
      "enum": [
        "validated",
        "grounded",
        "unsupported",
        "pending",
        "rejected"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "mode",
    "sourceUrl",
    "publisher",
    "documentTitle",
    "documentVersion",
    "contentHash",
    "locator",
    "content",
    "publishedAt",
    "availability",
    "ingestedAt",
    "revisedAt",
    "geography",
    "cropIds",
    "productIds",
    "units",
    "sourceUnits",
    "licence",
    "extraction",
    "validationStatus"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/EvidenceRecord.json",
  "x-schemaVersion": "1.0"
}
