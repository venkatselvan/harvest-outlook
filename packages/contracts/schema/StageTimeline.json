{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "cropId": {
      "type": "string"
    },
    "productId": {
      "type": [
        "string",
        "null"
      ]
    },
    "establishmentMethod": {
      "type": [
        "string",
        "null"
      ]
    },
    "anchorDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "stages": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "maxLength": 80
          },
          "from": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "to": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "basis": {
            "type": "string",
            "enum": [
              "sourced",
              "fao_generic",
              "estimate"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "from",
          "to",
          "basis"
        ],
        "additionalProperties": false
      }
    },
    "harvest": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "earliest": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            "latest": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            }
          },
          "required": [
            "earliest",
            "latest"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "basis": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "price_history",
            "yield_reference",
            "cost_reference",
            "sowing_window",
            "duration",
            "rotation",
            "water",
            "soil",
            "ndvi",
            "climatology",
            "model",
            "residue_reference",
            "emission_factor",
            "energy_reference"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "sourceId": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "label",
        "sourceId",
        "url",
        "scope",
        "note"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "cropId",
    "productId",
    "establishmentMethod",
    "anchorDate",
    "stages",
    "harvest",
    "basis"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/StageTimeline.json",
  "x-schemaVersion": "1.0"
}
