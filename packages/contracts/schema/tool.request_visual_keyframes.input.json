{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "planId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
    },
    "briefId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
    },
    "stageIds": {
      "minItems": 1,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
      }
    }
  },
  "required": [
    "planId",
    "briefId",
    "stageIds"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/tool.request_visual_keyframes.input.json",
  "x-schemaVersion": "1.0"
}
