{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
    },
    "botanicalName": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "commonNames": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          },
          "script": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "common",
              "local",
              "market",
              "botanical",
              "trade",
              "transliteration"
            ]
          },
          "sourceIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
            }
          }
        },
        "required": [
          "text",
          "language",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          },
          "script": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "common",
              "local",
              "market",
              "botanical",
              "trade",
              "transliteration"
            ]
          },
          "sourceIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
            }
          }
        },
        "required": [
          "text",
          "language",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "varieties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "language": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
                },
                "script": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "common",
                    "local",
                    "market",
                    "botanical",
                    "trade",
                    "transliteration"
                  ]
                },
                "sourceIds": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
                  }
                }
              },
              "required": [
                "text",
                "language",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
            }
          }
        },
        "required": [
          "id",
          "name",
          "aliases",
          "sourceIds"
        ],
        "additionalProperties": false
      }
    },
    "productIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
      }
    },
    "sourceMappings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
          },
          "nativeCode": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "nativeName": {
            "type": "string",
            "minLength": 1
          },
          "productId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "mapped",
              "unresolved",
              "rejected"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "sourceId",
          "nativeCode",
          "nativeName",
          "productId",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "live",
        "replay",
        "synthetic"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "botanicalName",
    "commonNames",
    "aliases",
    "varieties",
    "productIds",
    "sourceMappings",
    "mode"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/CropIdentity.json",
  "x-schemaVersion": "1.0"
}
