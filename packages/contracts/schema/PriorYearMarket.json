{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "productId": {
      "type": "string"
    },
    "period": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "to": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "basis": {
      "type": "string",
      "const": "same_calendar_period_previous_year"
    },
    "targetDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "targetBasis": {
      "type": "string",
      "enum": [
        "harvest_scenario",
        "planned_harvest",
        "as_of_date"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "unavailable"
      ]
    },
    "missingReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "type": "string",
      "enum": [
        "district",
        "state",
        "national",
        "unavailable"
      ]
    },
    "observations": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string"
          },
          "commodity": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "marketId": {
            "type": "string"
          },
          "marketName": {
            "type": "string"
          },
          "state": {
            "type": [
              "string",
              "null"
            ]
          },
          "district": {
            "type": [
              "string",
              "null"
            ]
          },
          "variety": {
            "type": [
              "string",
              "null"
            ]
          },
          "grade": {
            "type": [
              "string",
              "null"
            ]
          },
          "min": {
            "type": [
              "string",
              "null"
            ]
          },
          "modal": {
            "type": [
              "string",
              "null"
            ]
          },
          "max": {
            "type": [
              "string",
              "null"
            ]
          },
          "unit": {
            "type": "string",
            "const": "INR/quintal"
          },
          "unitBasis": {
            "type": "string",
            "enum": [
              "provider_declared",
              "agmarknet_convention"
            ]
          },
          "modalInrPerKg": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidenceState": {
            "type": "string",
            "const": "observed"
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "stale": {
            "type": "boolean"
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "productId",
          "commodity",
          "date",
          "marketId",
          "marketName",
          "state",
          "district",
          "variety",
          "grade",
          "min",
          "modal",
          "max",
          "unit",
          "unitBasis",
          "modalInrPerKg",
          "evidenceState",
          "source",
          "fetchedAt",
          "stale",
          "flags"
        ],
        "additionalProperties": false
      }
    },
    "coverageDays": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "productId",
    "period",
    "basis",
    "status",
    "missingReason",
    "scope",
    "observations",
    "coverageDays",
    "limitations"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/PriorYearMarket.json",
  "x-schemaVersion": "1.0"
}
