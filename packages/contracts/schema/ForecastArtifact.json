{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "live",
        "replay",
        "synthetic"
      ]
    },
    "evidenceState": {
      "type": "string",
      "const": "forecast"
    },
    "productId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
    },
    "marketIds": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
      }
    },
    "target": {
      "type": "object",
      "properties": {
        "statistic": {
          "type": "string",
          "enum": [
            "weekly_median_modal",
            "weekly_arrival_weighted_modal",
            "other_documented"
          ]
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "const": "INR/kg"
        }
      },
      "required": [
        "statistic",
        "definition",
        "unit"
      ],
      "additionalProperties": false
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "trainingCutoff": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "horizonDays": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "modelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
    },
    "modelKind": {
      "type": "string",
      "enum": [
        "baseline_last_value",
        "baseline_seasonal",
        "statistical_candidate"
      ]
    },
    "baselineIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
      }
    },
    "predictions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "period": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "end": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              }
            },
            "required": [
              "start",
              "end"
            ],
            "additionalProperties": false
          },
          "quantiles": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "level": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "exclusiveMaximum": 1
                },
                "value": {
                  "type": "number"
                }
              },
              "required": [
                "level",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "negativeQuantilesReported": {
            "type": "boolean"
          }
        },
        "required": [
          "period",
          "quantiles",
          "negativeQuantilesReported"
        ],
        "additionalProperties": false
      }
    },
    "evaluation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reportId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "reportId",
            "scope"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "featureVersions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
          },
          "version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "string",
                "minLength": 1
              }
            ]
          }
        },
        "required": [
          "id",
          "version"
        ],
        "additionalProperties": false
      }
    },
    "missingness": {
      "type": "object",
      "properties": {
        "fractionMissingWeeks": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "fractionMissingWeeks",
        "notes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "mode",
    "evidenceState",
    "productId",
    "marketIds",
    "target",
    "issuedAt",
    "trainingCutoff",
    "horizonDays",
    "modelId",
    "modelKind",
    "baselineIds",
    "predictions",
    "evaluation",
    "featureVersions",
    "missingness"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/ForecastArtifact.json",
  "x-schemaVersion": "1.0"
}
