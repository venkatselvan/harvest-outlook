{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "methodVersion": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "incomplete",
        "invalid"
      ]
    },
    "evidenceState": {
      "type": "string",
      "enum": [
        "derived",
        "scenario"
      ]
    },
    "missingInputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permittedPrecision": {
      "type": "string",
      "enum": [
        "range_only",
        "rounded_5mm"
      ]
    },
    "dimensionalCheck": {
      "type": "object",
      "properties": {
        "litresPerMmHa": {
          "type": "number"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "required": [
        "litresPerMmHa",
        "passed"
      ],
      "additionalProperties": false
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "evidenceState": {
            "type": "string",
            "enum": [
              "derived",
              "scenario"
            ]
          },
          "tawMm": {
            "type": [
              "number",
              "null"
            ]
          },
          "etcMm": {
            "type": "number"
          },
          "effectiveRainMm": {
            "type": "number"
          },
          "effectiveRainFromForecastMm": {
            "type": "number"
          },
          "netIrrigationMm": {
            "type": "number"
          },
          "grossIrrigationMm": {
            "type": [
              "number",
              "null"
            ]
          },
          "grossLitresPerHa": {
            "type": [
              "number",
              "null"
            ]
          },
          "grossLitresTotal": {
            "type": [
              "number",
              "null"
            ]
          },
          "deepPercolationMm": {
            "type": "number"
          },
          "stressDays": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "netMm": {
                  "type": "number"
                }
              },
              "required": [
                "date",
                "netMm"
              ],
              "additionalProperties": false
            }
          },
          "daily": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "kc": {
                  "type": "number"
                },
                "etcMm": {
                  "type": "number"
                },
                "effectiveRainMm": {
                  "type": "number"
                },
                "rainState": {
                  "type": "string",
                  "enum": [
                    "observed",
                    "forecast",
                    "missing"
                  ]
                },
                "irrigationNetMm": {
                  "type": "number"
                },
                "depletionEndMm": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              },
              "required": [
                "date",
                "kc",
                "etcMm",
                "effectiveRainMm",
                "rainState",
                "irrigationNetMm",
                "depletionEndMm"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "label",
          "evidenceState",
          "tawMm",
          "etcMm",
          "effectiveRainMm",
          "effectiveRainFromForecastMm",
          "netIrrigationMm",
          "grossIrrigationMm",
          "grossLitresPerHa",
          "grossLitresTotal",
          "deepPercolationMm",
          "stressDays",
          "events",
          "daily"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "methodVersion",
    "status",
    "evidenceState",
    "missingInputs",
    "errors",
    "assumptions",
    "permittedPrecision",
    "dimensionalCheck",
    "runs"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/WaterBalanceResult.json",
  "x-schemaVersion": "1.0"
}
