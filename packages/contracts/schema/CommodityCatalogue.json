{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "snapshot": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "checkedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "complete": {
              "type": "boolean"
            },
            "commodityCount": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "rowCount": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "sourceUrl": {
              "type": "string",
              "format": "uri"
            },
            "limitations": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "id",
            "checkedAt",
            "complete",
            "commodityCount",
            "rowCount",
            "sourceUrl",
            "limitations"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "total": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "offset": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "limit": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "commodityId": {
            "type": "string"
          },
          "sourceCommodity": {
            "type": "string"
          },
          "grouping": {
            "type": "string"
          },
          "identityStatus": {
            "type": "string"
          },
          "identityNote": {
            "type": [
              "string",
              "null"
            ]
          },
          "botanicalName": {
            "type": [
              "string",
              "null"
            ]
          },
          "profileId": {
            "type": [
              "string",
              "null"
            ]
          },
          "profileStatus": {
            "type": "string",
            "enum": [
              "researched",
              "pending",
              "not_applicable"
            ]
          },
          "profileUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "cropId": {
            "type": [
              "string",
              "null"
            ]
          },
          "productId": {
            "type": [
              "string",
              "null"
            ]
          },
          "priceCoverage": {
            "type": "object",
            "properties": {
              "validRows": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "modalRows": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "dateRange": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  "to": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  }
                },
                "required": [
                  "from",
                  "to"
                ],
                "additionalProperties": false
              },
              "states": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "marketCount": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "unitStatus": {
                "type": "string",
                "const": "provider_unit_not_declared"
              },
              "examples": {
                "type": "array",
                "items": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              }
            },
            "required": [
              "validRows",
              "modalRows",
              "dateRange",
              "states",
              "marketCount",
              "unitStatus",
              "examples"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "commodityId",
          "sourceCommodity",
          "grouping",
          "identityStatus",
          "identityNote",
          "botanicalName",
          "profileId",
          "profileStatus",
          "profileUrl",
          "cropId",
          "productId",
          "priceCoverage"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "snapshot",
    "total",
    "offset",
    "limit",
    "items"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/CommodityCatalogue.json",
  "x-schemaVersion": "1.0"
}
