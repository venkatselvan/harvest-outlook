{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "candidateId": {
      "type": "string"
    },
    "cropId": {
      "type": "string"
    },
    "productId": {
      "type": "string"
    },
    "cropName": {
      "type": "string"
    },
    "productName": {
      "type": "string"
    },
    "rank": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "reason": {
      "type": "string",
      "maxLength": 1000
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "scope": {
      "type": "string",
      "enum": [
        "district",
        "state",
        "region",
        "national"
      ]
    },
    "nextSowingDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "sowingWindow": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            "to": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            }
          },
          "required": [
            "from",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "harvestWindow": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "earliest": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            },
            "latest": {
              "type": "string",
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
            }
          },
          "required": [
            "earliest",
            "latest"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "availability": {
      "type": "string",
      "enum": [
        "free_window",
        "conflicts_with_existing_plan",
        "unknown_current_harvest"
      ]
    }
  },
  "required": [
    "candidateId",
    "cropId",
    "productId",
    "cropName",
    "productName",
    "rank",
    "reason",
    "evidenceRefs",
    "uncertainties",
    "scope",
    "nextSowingDate",
    "sowingWindow",
    "harvestWindow",
    "availability"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/PlanningComparison.json",
  "x-schemaVersion": "1.0"
}
