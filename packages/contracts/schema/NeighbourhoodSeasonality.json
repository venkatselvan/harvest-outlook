{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "farmId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "unavailable"
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 80
        },
        {
          "type": "null"
        }
      ]
    },
    "window": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "to": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "activeThreshold": {
      "type": "number",
      "minimum": -1,
      "maximum": 1
    },
    "months": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "monthOfYear": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "meanNdvi": {
            "anyOf": [
              {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "usableScenes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "analysedScenes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "month",
          "monthOfYear",
          "meanNdvi",
          "usableScenes",
          "analysedScenes"
        ],
        "additionalProperties": false
      }
    },
    "activeMonths": {
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12
      }
    },
    "scenesPending": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "limitations": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 400
      }
    }
  },
  "required": [
    "farmId",
    "status",
    "reason",
    "window",
    "activeThreshold",
    "months",
    "activeMonths",
    "scenesPending",
    "limitations"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/NeighbourhoodSeasonality.json",
  "x-schemaVersion": "1.0"
}
