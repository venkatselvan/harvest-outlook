{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "scope": {
      "type": "string",
      "enum": [
        "district",
        "state",
        "region",
        "national"
      ]
    },
    "geographyIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewStatus": {
      "type": "string",
      "enum": [
        "source_checked",
        "pending"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    }
  },
  "required": [
    "id",
    "title",
    "url",
    "scope",
    "geographyIds",
    "reviewStatus",
    "limitations"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/PlanningEvidence.json",
  "x-schemaVersion": "1.0"
}
