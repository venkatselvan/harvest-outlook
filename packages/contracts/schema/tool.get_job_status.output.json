{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "jobId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "resultIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\/-]*$"
      }
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "jobId",
    "state",
    "progress",
    "resultIds",
    "errorCode"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/tool.get_job_status.output.json",
  "x-schemaVersion": "1.0"
}
