{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "productId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "insufficient"
      ]
    },
    "missingReason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "price_history_not_ingested",
            "price_history_insufficient",
            "market_not_in_history",
            "price_residuals_insufficient",
            "price_interval_crossing"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "market",
            "district",
            "state",
            "national"
          ]
        },
        "requestedLevel": {
          "type": "string",
          "enum": [
            "market",
            "district",
            "state",
            "national"
          ]
        },
        "stateName": {
          "type": [
            "string",
            "null"
          ]
        },
        "districtName": {
          "type": [
            "string",
            "null"
          ]
        },
        "marketCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "marketIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fallbackNote": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "level",
        "requestedLevel",
        "stateName",
        "districtName",
        "marketCount",
        "marketIds",
        "fallbackNote"
      ],
      "additionalProperties": false
    },
    "unit": {
      "type": "string",
      "const": "INR/kg"
    },
    "priceBasis": {
      "type": "string",
      "const": "wholesale_mandi_modal"
    },
    "basisLabel": {
      "type": "string",
      "maxLength": 1000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "method": {
      "type": "string",
      "const": "B_seasonal_reference/pooled-v1"
    },
    "harvestDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "harvestWeek": {
      "type": "object",
      "properties": {
        "year": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "week": {
          "type": "integer",
          "minimum": 1,
          "maximum": 53
        }
      },
      "required": [
        "year",
        "week"
      ],
      "additionalProperties": false
    },
    "asOf": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "weekWindow": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "yearsRequested": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "yearsConsidered": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "yearsUsed": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -9007199254740991,
        "maximum": 9007199254740991
      }
    },
    "perYear": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "year": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "weeks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "median": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "year",
          "weeks",
          "median"
        ],
        "additionalProperties": false
      }
    },
    "p10": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "p25": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "p50": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "p75": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "p90": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "annualMean": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "annualWeeks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "weeksUsed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "observations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "marketsUsed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "residualCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "productId",
    "status",
    "missingReason",
    "scope",
    "unit",
    "priceBasis",
    "basisLabel",
    "limitations",
    "method",
    "harvestDate",
    "harvestWeek",
    "asOf",
    "weekWindow",
    "yearsRequested",
    "yearsConsidered",
    "yearsUsed",
    "perYear",
    "p10",
    "p25",
    "p50",
    "p75",
    "p90",
    "annualMean",
    "annualWeeks",
    "weeksUsed",
    "observations",
    "marketsUsed",
    "residualCount"
  ],
  "additionalProperties": false,
  "$id": "https://harvest-outlook.local/schema/1.0/HarvestPriceOutlook.json",
  "x-schemaVersion": "1.0"
}
