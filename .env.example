# Copy to .env and edit. Placeholders only; never commit real values.
# Never use VITE_ variables for credentials.

DATABASE_URL=postgres://harvest:harvest_local_only@localhost:5432/harvest_outlook_dev
# Used by API tests (apps/api/test/db.test.ts); this database is wiped by the tests.
TEST_DATABASE_URL=postgres://harvest:harvest_local_only@localhost:5432/harvest_outlook_test

# live | replay | synthetic (server controlled)
RUNTIME_MODE=synthetic
# At least 32 characters; generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
ALLOWED_ORIGINS=http://localhost:5173
PORT=8787

STORAGE_DRIVER=fs
STORAGE_FS_ROOT=.data/storage

# Meta runtime provider (leave blank in synthetic mode)
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=muse-spark-1.3
META_ESCALATION_MODEL=muse-wonder-1.0
META_IMAGE_MODEL=muse-image-1.0
META_SEGMENT_MODEL=sam-3.1

# ElevenLabs speech only (leave blank when unused)
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=
ELEVENLABS_TTS_MODEL=
ELEVENLABS_VOICE_ID=

# Spending policy (USD)
BUDGET_TOTAL_USD=150
BUDGET_DEV_ALLOCATION_USD=120
BUDGET_DEMO_RESERVE_USD=30

MAX_UPLOAD_IMAGE_BYTES=10485760
MAX_VOICE_SECONDS=60
