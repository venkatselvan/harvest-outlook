# Copy to .env and edit. Placeholders only; never commit real values.
# Never use VITE_ variables for credentials.

DATABASE_URL=postgres://harvest:harvest_local_only@localhost:5432/harvest_outlook_dev
# Used by API tests (apps/api/test/db.test.ts); this database is wiped by the tests.
TEST_DATABASE_URL=postgres://harvest:harvest_local_only@localhost:5432/harvest_outlook_test

# live | replay | synthetic (server controlled)
RUNTIME_MODE=synthetic
# At least 32 characters; generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
ALLOWED_ORIGINS=http://localhost:5173
# Optional: accept requests with no Origin header (non-browser clients). Keep false outside local tooling.
ALLOW_MISSING_ORIGIN=false
PORT=8787

STORAGE_DRIVER=fs
STORAGE_FS_ROOT=.data/storage

# Meta runtime provider (leave blank in synthetic mode)
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=muse-spark-1.3
META_ESCALATION_MODEL=muse-wonder-1.0
META_IMAGE_MODEL=muse-image-1.0
META_SEGMENT_MODEL=sam-3.1

# Meta speech recognition only; speech synthesis has no active provider.
META_STT_MODEL=muse-voice-transcribe-1.0

# Spending policy (USD)
BUDGET_TOTAL_USD=150
BUDGET_DEV_ALLOCATION_USD=120
BUDGET_DEMO_RESERVE_USD=30
# Per-session and per-owner-day reservation caps (USD)
BUDGET_PER_SESSION_USD=3
BUDGET_PER_OWNER_DAY_USD=10
# Global daily cap (USD, UTC day) for the automatic once-per-farm-per-day grounded alert review (Meta web search).
# When reached, weather/price checks still run and the news review is reported as paused. 0 pauses it entirely.
MONITOR_META_DAILY_CAP_USD=3

MAX_UPLOAD_IMAGE_BYTES=10485760
MAX_VOICE_SECONDS=60

# Market and weather data providers
# data.gov.in needs a free API key (user registration required). Leave blank to keep the adapter disabled.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_BASE_URL=https://api.data.gov.in
DATA_GOV_IN_MAX_PAGES=20
DATA_GOV_IN_MAX_RECORDS=10000
# Open-Meteo works without a key (free tier: CC BY 4.0, non-commercial use; attribution required).
OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPENMETEO_ARCHIVE_TTL_SECONDS=86400
OPENMETEO_FORECAST_TTL_SECONDS=10800
# Shared HTTP behaviour for data providers
PROVIDER_TIMEOUT_MS=15000
PROVIDER_MAX_RETRIES=2

# Assistant loop ceilings (docs/AGENT_RUNTIME.md); defaults shown
AGENT_MAX_TOOL_ROUNDS=6
AGENT_MAX_TOOL_CALLS=12
# Clamped to 1
AGENT_MAX_WONDER_ESCALATIONS=1
AGENT_MAX_REPAIR_ATTEMPTS=2
AGENT_WONDER_ENABLED=false
AGENT_MAX_OUTPUT_TOKENS=3000
AGENT_INTERPRETATION_MAX_OUTPUT_TOKENS=1200
# minimal | low | medium | high | max (leave blank for the provider default)
AGENT_REASONING_EFFORT=
AGENT_RAIN_HORIZON_DAYS=7
ASSISTANT_TURNS_PER_MINUTE=20
# Synthetic mode only: recorded fixture scenario replayed by the fixture provider
AGENT_FIXTURE_SCENARIO=profile_extraction

# SAM region proposals (docs/PHOTO_REGION.md). Several parameter placements are UNVERIFIED against the live API.
SAM_STREAM=true
SAM_MASK_ENCODING=onebit
SAM_INCLUDE_CONFIDENCE=true
SAM_BASE85_VARIANT=auto
SAM_BIT_ORDER=msb
SAM_MAX_IMAGE_SIDE=1024
SAM_TIMEOUT_MS=45000

# Weather climatology: complete past years used for daily normals (needs >= 5 years of stored archive rows)
WEATHER_CLIMATOLOGY_YEARS=10
WEATHER_CLIMATOLOGY_END_YEAR=

# Review fixes (F2)
# Cookie Secure flag: auto = true in production, otherwise only for non-localhost origins. Secure cookies use the __Host- prefix.
COOKIE_SECURE=auto
# Idempotency keys (and their stored responses) are purged after this many hours.
IDEMPOTENCY_TTL_HOURS=24
# Per client-IP (salted hash) daily spend cap in USD, across all guest sessions from that IP.
BUDGET_PER_IP_DAY_USD=15
# Worker job lease in seconds; the worker heartbeats every third of it while a handler runs.
JOB_LEASE_SECONDS=30
